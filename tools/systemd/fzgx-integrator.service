[Unit]
Description=Publish verified fzgx main to the approved GitHub fork
After=network-online.target
Conflicts=fzgx-autopr.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/fzgx
ExecStart=%h/projects/fzgx/.venv/bin/python %h/projects/fzgx/tools/fleet_integrator.py once
Environment=PYTHONUNBUFFERED=1
Environment=GIT_TERMINAL_PROMPT=0
Environment=PATH=/home/armandofm/.local/bin:/home/armandofm/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=35min
UMask=0077
